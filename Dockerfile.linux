# ============================================================
# Stage 1: Build Linux binary with PyInstaller
# ============================================================
FROM ubuntu:22.04 AS builder

RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    python3 python3-pip python3-venv python3-dev python3-tk \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Install PyInstaller + deps
COPY requirements.txt .
RUN python3 -m venv .venv \
    && . .venv/bin/activate \
    && pip install --no-cache-dir -r requirements.txt psutil pyinstaller

# Copy source
COPY app/ app/
COPY assets/ assets/
COPY linux.spec .

# Build binary
RUN . .venv/bin/activate \
    && pyinstaller linux.spec --clean --noconfirm \
    && chmod +x dist/zeroblockbridge

# ============================================================
# Stage 2: Minimal runtime (no Python, no build tools)
# ============================================================
FROM ubuntu:22.04

LABEL maintainer="DesvoSoft"
LABEL description="ZeroBlockBridge — Minecraft Server Manager (Linux)"

ENV DEBIAN_FRONTEND=noninteractive

# Only: X11 libs for display + JRE for MC servers + minimal runtime deps
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
       libx11-6 libxext6 libxft2 libxss1 \
       libtk8.6 libtcl8.6 \
       openjdk-17-jre-headless \
       ca-certificates \
    && apt-get purge -y --auto-remove \
    && rm -rf /var/lib/apt/lists/* /tmp/* /usr/share/doc /usr/share/man \
              /usr/share/locale /usr/share/zoneinfo /usr/share/tcltk \
              /usr/share/fonts /usr/share/X11

WORKDIR /opt/zeroblockbridge

# Copy binary + assets
COPY --from=builder /build/dist/zeroblockbridge .
COPY --from=builder /build/assets assets/

# Persistent dirs
RUN mkdir -p servers .zbb_data

EXPOSE 25565

CMD ["./zeroblockbridge"]
